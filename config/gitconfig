# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = Erik Weibust
	email = erikweibust@gmail.com
	username = erikweibust

[alias]
trashit = !git reset --hard HEAD && git clean -f -d
	loga = log --oneline --graph --all
	aliases = config --list --show-origin
[init]
	defaultBranch = master
[push]
	default = simple
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.dotfiles/config/allowed_signers
[core]
	autocrlf = input

[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/dev/projects/"]
	path = ~/.dotfiles/config/gitconfig-herodevs
