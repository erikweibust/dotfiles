# This is Git's per-user configuration file.
#
# IDENTITY: there is deliberately no global user.email. useConfigOnly makes git
# refuse to guess one, so a repo outside the includeIf trees below fails loudly
# instead of committing under the wrong address. Fix those with a one-off:
#   git config user.email you@wherever
#
#   ~/dev/work/      -> erik.weibust@herodevs.com
#   ~/dev/personal/  -> erikweibust@gmail.com
#   ~/.dotfiles/     -> erikweibust@gmail.com
#
# Signing key + commit.gpgsign live in ~/.gitconfig.local (per machine, untracked).

[user]
	name = Erik Weibust
	username = erikweibust
	useConfigOnly = true

[alias]

# to know which email I'm using. Think of this as am I working on a personal or work
# project.
   whoami = "!echo Name:  $(git config user.name); \
              echo Email: $(git config user.email); \
              echo Key:   $(git config user.signingkey)"

	trashit = !git reset --hard HEAD && git clean -f -d
	loga = log --oneline --graph --all
	aliases = config --list --show-origin
[init]
	defaultBranch = master
[push]
	default = simple
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.dotfiles/config/allowed_signers
[core]
	autocrlf = input

[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/dev/work/"]
	path = ~/.dotfiles/config/gitconfig-herodevs
[includeIf "gitdir:~/dev/personal/"]
	path = ~/.dotfiles/config/gitconfig-personal
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles/config/gitconfig-personal
